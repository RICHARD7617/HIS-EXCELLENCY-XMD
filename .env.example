PAIR_NUMBER=254700000000
OWNER_NUMBER=254700000000
OWNER_NAME=Owner
PREFIX=.
MODE=PUBLIC
TIMEZONE=Africa/Lagos
# Optional
BOT_NAME=
BOT_IMAGE=
SESSION_DIR=session
DATABASE_URL=
# Set DATABASE_URL to the Heroku Postgres add-on URL in production.
PG_POOL_MAX=5
PGSSLMODE=require
# Required for encrypted PostgreSQL storage. Generate with: openssl rand -base64 32
XMD_STORAGE_KEY=
SEND_STARTUP_MSG=true
COOLDOWN_MS=2000
MAX_PER_MIN=15
